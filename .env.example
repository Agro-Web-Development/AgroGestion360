# Copia este archivo a .env.local y completa los valores.
# Obtén los valores locales con: npx supabase status

# Públicas (se envían al navegador). Solo URL y clave publicable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privada: SOLO servidor. Nunca uses el prefijo NEXT_PUBLIC_ con esta clave.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Opcional (desarrollo): registra el service worker con `next dev` para probar la PWA.
# NEXT_PUBLIC_ENABLE_SW=1
